rpareto <- function(n, x, theta = 1, alpha = 3) {
U <- runif(U)
return(theta / (1 - U)^(1/3))
}
rpareto(3)
rpareto <- function(n, x, theta = 1, alpha = 3) {
U <- runif(n)
return(theta / (1 - U)^(1/3))
}
rpareto(3)
rpareto(100)
hist(rpareto(100))
hist(rpareto(100, 5))
rpareto <- function(n, theta = 1, alpha = 3) {
U <- runif(n)
return(theta / (1 - U)^(1/3))
}
hist(rpareto(100, 5))
hist(rpareto(100, 1))
hist(rpareto(100, 3))
hist(rpareto(1000, 3))
set.seed(123)
rpareto(5, 8)
rpareto(5, 8)
rpareto <- function(n, theta = 1, alpha = 3) {
U <- runif(n)
return(theta / (1 - U)^(1/3))
}
hist(rpareto(1000, 3))
set.seed(123)
x <- rpareto(5, 8)
(2/3) * mean(x)
min(x)
