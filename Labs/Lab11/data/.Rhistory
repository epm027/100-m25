rpareto <- function(n, theta = 1, alpha = 3) {
U <- runif(n)
return(theta / (1 - U)^(1/3))
}
hist(rpareto(1000, 3))
set.seed(123)
x <- rpareto(5, 8) %>% round(3)
(2/3) * mean(x)
min(x)
