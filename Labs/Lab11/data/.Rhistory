dat1 <- make_ma_data(n = 2^11,
seed = 100,
sigma_0 = 1.5,
sigma_signal = 10,
ell = 0.1,
ma_coefs = rep(1/sqrt(5), 5))
orig_data <- dat1$res %>% ggplot(aes(x = x)) +
geom_point(aes(y = y, colour = "data"), alpha = 0.1) +
geom_line(aes(y = signal, colour = "signal"), linewidth = 1) +
theme_minimal() +
ggtitle("Simulated Dataset with True Trend")
##########
## OPTIMIZE UNDER WHITE NOISE ###
#########
ell_vals_sim_wn <- seq(0.003, 0.005, length = 100)
start_coef <- c(10, 1)
devs_sim1_wn <- c()
for(ell in ell_vals_sim_wn) {
temp_fit <- fit_proc_ma_q(dat1$res$x,
dat1$res$y,
ma_order = 0,
start_coef = start_coef,
ell = ell)
devs_sim1_wn <- c(devs_sim1_wn, temp_fit$dev)
start_coef <- temp_fit$coefs
}
plot(ell_vals_sim_wn, devs_sim1_wn, type = "l")
ell_opt_sim_wn <- ell_vals_sim_wn[which.min(devs_sim1_wn)]
fit_opt_wn <- fit_proc_ma_q(dat1$res$x,
dat1$res$y,
ma_order = 0,
start_coef = start_coef,
ell = ell_opt_sim_wn)
wn_fit <- dat1$res %>% mutate(
fitted = fit_opt_wn$fitted
) %>% ggplot(aes(x = x)) +
geom_point(aes(y = y, colour = "data"), alpha = 0.1) +
geom_line(aes(y = fitted, colour = "fitted"), linewidth = 1) +
ggtitle("Optimal Fit; White Noise") +
theme_minimal() +
labs(colour = "Legend")
##########
## OPTIMIZE UNDER MA(5) ###
#########
ell_vals_sim <- seq(0.05, 0.15, length = 100)
start_coef <- c(10, 90, rep(0.1, 5))
devs_sim1 <- c()
for(ell in ell_vals_sim) {
temp_fit <- fit_proc_ma_q(dat1$res$x,
dat1$res$y,
ma_order = 5,
start_coef = start_coef,
ell = ell)
devs_sim1 <- c(devs_sim1, temp_fit$dev)
start_coef <- temp_fit$coefs
}
ell_opt_sim <- ell_vals_sim[which.min(devs_sim1)]
fit_opt <- fit_proc_ma_q(dat1$res$x,
dat1$res$y,
ma_order = 5,
start_coef = start_coef,
ell = ell_opt)
ma_fit <- dat1$res %>% mutate(
fitted = fit_opt$fitted
) %>% ggplot(aes(x = x)) +
geom_point(aes(y = y, colour = "data"), alpha = 0.1) +
geom_line(aes(y = fitted, colour = "fitted"), linewidth = 1) +
ggtitle("Optimal Fit; MA(5) Noise") +
theme_minimal() +
labs(colour = "Legend")
#| label: fig-obama
#| fig-cap: "Optimal fits in the time domain, as determined by Algothm (\\ref{alg:alg1}). The bandwidth was optimized through a grid-search for the value that minimizes model deviance. Top: modeling the noise as White Noise (ignoring the correlation structure). Bottom: modeling the noise as an MA(2) Noise. In both cases, a Matérn-5/2 kernel was used for the covariance kernel of the Gaussian Process prior."
#| warning: False
#| message: False
#| echo: False
#| fig-align: 'center'
#| fig-height: 5
#| fig-width: 6
#| fig-pos: "H"
## WHITE NOISE FIT
ell_vals_wn <- seq(0.001, 0.005, length = 100)
start_coef <- c(4, 5e2)
devs_obama_wn <- c()
for(ell in ell_vals_wn) {
temp_fit <- fit_proc_ma_q(Obama$`End Date`,
Obama$Approving,
ma_order = 0,
start_coef = start_coef,
ell = ell)
devs_obama_wn <- c(devs_obama_wn, temp_fit$dev)
start_coef <- temp_fit$coefs
}
#| echo: False
#| fig-cap: "Approval percentages for President Obama during his two terms in office. Each point represents the average of approval ratings across three days; the date in question, the day before, and two days before. Data sourced from The American Presidency Project at the University of California, Santa Barbara."
Obama <- read_excel("data/ObamaApproval.xlsx",
col_types = c("skip", "skip", "skip",
"date", "date", "numeric",
"numeric", "numeric")
)
Obama %>% ggplot(aes(x = `End Date`, y = Approving)) +
geom_point() + ylab("% Approving") +
ggtitle("Approval Ratings for Pres. Obama") +
theme_minimal()
